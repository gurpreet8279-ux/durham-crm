rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core bookings & leads collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Public bookings collection (for online customer forms)
    match /public_bookings/{bookingId} {
      allow read, write: if true;
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Incoming requests collection
    match /incoming_requests/{requestId} {
      allow read, write: if true;
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Connection test collection
    match /_connection_test/{testId} {
      allow read, write: if true;
    }

    // User-specific fallback paths
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
